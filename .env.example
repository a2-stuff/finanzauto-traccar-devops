# Copia este archivo a .env y completa los valores. Nunca lo confirmes en git.
# Credenciales dummy de Floci (no son secretos reales de AWS).
AWS_PROFILE=floci
AWS_ENDPOINT_URL=http://localhost:4566
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# Demo local (docker compose) y simulador GPS
TRACCAR_ADMIN_EMAIL=admin
TRACCAR_ADMIN_PASSWORD=cambialo
TRACCAR_DEVICE_ID=demo-osmand
TRACCAR_OSMAND_URL=http://127.0.0.1:5055
TRACCAR_WEB_URL=http://127.0.0.1:8082
